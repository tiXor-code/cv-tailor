<!DOCTYPE html>
{# One template, two housings of the same content.
   ats=False -> human-facing designed CV (cv_designed.pdf): metric tile band.
   ats=True  -> designed-ATS twin (cv_designed_ats.pdf): no band; the tiles
                arrive as `highlights` sentences in a linear section.
   Tiles are chosen and honesty-checked in cv_tailor.variants; every tile
   number also appears in a bullet below. #}
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ profile.contact.name }} - CV</title>
  <meta name="author" content="{{ profile.contact.name }}">
  <link rel="stylesheet" href="cv_designed.css">
</head>
<body class="{{ 'ats' if ats else 'designed' }}{{ ' compact' if compact else '' }}">

<header class="contact">
  <h1>{{ profile.contact.name }}</h1>
  {% set headline = fields.get('headline') or profile.contact.get('headline') %}
  {% if headline %}<p class="headline">{{ headline }}</p>{% endif %}
  <p class="contact-line">
    {{ profile.contact.location }}{% if profile.contact.timezone %} ({{ profile.contact.timezone }}){% endif %}
    {% if profile.contact.work_mode %} &middot; {{ profile.contact.work_mode }}{% endif %}
    &middot; <a href="mailto:{{ profile.contact.email }}">{{ profile.contact.email }}</a>
    &middot; {{ profile.contact.phone }}
    {% if profile.contact.website %} &middot; <a href="https://{{ profile.contact.website }}">{{ profile.contact.website }}</a>{% endif %}
    {% if profile.contact.linkedin %} &middot; <a href="https://{{ profile.contact.linkedin }}">{{ profile.contact.linkedin }}</a>{% endif %}
    {% if profile.contact.github %} &middot; <a href="https://{{ profile.contact.github }}">{{ profile.contact.github }}</a>{% endif %}
  </p>
</header>

{% if tiles and not ats %}
<div class="tiles">
  {% for t in tiles %}
  <div class="tile">
    <span class="tile-value">{{ t.value }}</span>
    <span class="tile-label">{{ t.label }}</span>
    <span class="tile-source">{{ t.source }}</span>
  </div>
  {% endfor %}
</div>
{% endif %}

<section>
  <h2>Summary</h2>
  <p>{% if ats %}{{ fields.summary_rewrite | expand_acronyms }}{% else %}{{ fields.summary_rewrite }}{% endif %}</p>
</section>

{% if highlights %}
<section>
  <h2>Selected Results</h2>
  <ul>
    {% for h in highlights %}
    <li>{{ h }}</li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section>
  <h2>Experience</h2>
  {% for exp_id in fields.experience_ids_ordered %}
    {% set exp = experiences_by_id[exp_id] %}
    <article class="experience">
      <h3>{{ exp.company }} | {{ exp.role }}</h3>
      <p class="meta">{{ exp.dates }} &middot; {{ exp.location }}</p>
      {% if exp.description %}<p class="company-line">{% if ats %}{{ exp.description | expand_acronyms }}{% else %}{{ exp.description }}{% endif %}</p>{% endif %}
      <ul>
        {% for idx in fields.experience_bullets.get(exp_id, []) %}
          <li>{% if ats %}{{ exp.bullets[idx] | expand_acronyms | emphasize(exp.emphasis) }}{% else %}{{ exp.bullets[idx] | emphasize(exp.emphasis) }}{% endif %}</li>
        {% endfor %}
      </ul>
    </article>
  {% endfor %}
</section>

{% if fields.project_ids %}
<section>
  <h2>Projects</h2>
  {% for pid in fields.project_ids %}
    {% set proj = projects_by_id[pid] %}
    <article class="project">
      <h3>{{ proj.name }}</h3>
      <p class="meta">{% if ats %}{{ proj.tagline | expand_acronyms }}{% else %}{{ proj.tagline }}{% endif %}{% if proj.link %} &middot; <a href="https://{{ proj.link }}">{{ proj.link }}</a>{% endif %}</p>
      <ul>
        {% for b in proj.bullets %}
          <li>{% if ats %}{{ b | expand_acronyms | emphasize(proj.emphasis) }}{% else %}{{ b | emphasize(proj.emphasis) }}{% endif %}</li>
        {% endfor %}
      </ul>
    </article>
  {% endfor %}
</section>
{% endif %}

<section>
  <h2>Skills</h2>
  {# Same labels as cv.html.j2 (and variants.SKILL_LABELS for the DOCX):
     "languages" is the stack of the systems he ships with Claude Code. #}
  {% set skill_labels = {"languages": "Stack", "ai": "AI", "devops": "DevOps"} %}
  {% set group_names = fields.skills_groups if fields.get('skills_groups') else profile.skills.keys() %}
  {% for group in group_names %}
    {% if group in profile.skills %}
    <p class="skill-row">
      <span class="skill-group">{{ skill_labels.get(group, group | title) }}:</span>
      {% for item in profile.skills[group] %}
        {% if item in fields.skills_emphasis %}<strong>{{ item }}</strong>{% else %}{{ item }}{% endif %}{% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
    {% endif %}
  {% endfor %}
</section>

<section>
  <h2>Education</h2>
  {% for ed in profile.education %}
    <p>{{ ed.degree }}, {{ ed.institution }} &middot; {{ ed.get('dates') or ed.year }}{% if ed.notes %}<br><span class="meta">{{ ed.notes }}</span>{% endif %}</p>
  {% endfor %}
</section>

{% if profile.get('certifications') %}
<section>
  <h2>Certifications</h2>
  {% for c in profile.certifications %}
    <p>{{ c.name }}{% if c.get('issuer') %}, {{ c.issuer }}{% endif %}{% if c.get('year') %} &middot; {{ c.year }}{% endif %}</p>
  {% endfor %}
</section>
{% endif %}

{% if profile.get('languages_spoken') %}
<section>
  <h2>Languages</h2>
  <p>{% for l in profile.languages_spoken %}{{ l.language }} ({{ l.level }}){% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
</section>
{% endif %}

</body>
</html>
