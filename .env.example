# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Google Sheets CRM
GOOGLE_SERVICE_ACCOUNT_PATH=.secrets/sa.json
SHEET_ID=

# Discovery v2 (Phase 2) — Google Jobs aggregator + SMB enrichment
# Reused from the icp-agent Vercel project.
SERPAPI_API_KEY=
HUNTER_API_KEY=

# Scout Phase A - gated application sender (src/cv_tailor/sender.py)
# SMTP identity used to send job applications (smtp.gmail.com:587 STARTTLS).
APPLY_SMTP_USER=you@example.com
# Gmail app password for the address above (never the account password).
APPLY_SMTP_PASSWORD=
# "1" arms real sends to the job's apply_target; anything else (default "0")
# is unarmed and previews every send to APPLY_SMTP_USER's own inbox instead.
APPLY_ARMED=0
# Max armed sends per calendar day, counted from the applications ledger.
APPLY_DAILY_CAP=10
# RETIRED: AUTO_APPLY. scripts/scan.py used to auto-approve and apply every
# pending job in the day's queue itself, regardless of score. It no longer
# applies at all, so the variable is read by nothing -- setting it does nothing.
# scripts/autopilot.py (SCOUT_AUTOPILOT below) is the sole apply owner.
#
# "1" enables the autopilot pass run_scan.sh fires after every scan: approve
# every pending entry above the score floor, run apply_approved.py for each,
# expire stale entries, send one Telegram digest.
SCOUT_AUTOPILOT=0
# Score an entry must reach before autopilot applies to it unattended. Read
# fresh on every pass. This can only RAISE the bar: 6 is the hard floor in
# code, and anything lower (or unparseable) here is clamped back up to 6.
SCOUT_AUTO_APPROVE_MIN=6
